# PTA Backend — Vercel Environment Variables
# Paste into the BACKEND Vercel project (Root Directory: backend)
# Copy to deploy/backend.env and fill before uploading to Vercel.

# Production URLs (must match real Vercel domains)
FRONTEND_URL=https://progress-track-app.vercel.app
BACKEND_PUBLIC_URL=https://backend-six-roan-24.vercel.app
NEXT_PUBLIC_API_URL=https://backend-six-roan-24.vercel.app
NEXT_PUBLIC_APP_URL=https://progress-track-app.vercel.app

# Firebase client config (same public keys as frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (FCM server send) — one-line JSON OR discrete fields
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Calendar OAuth
# Authorized redirect: https://YOUR-BACKEND.vercel.app/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (server secrets — never put on frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
# PTA_ALLOW_DEMO_LOGIN=true
