rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsResource() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function ownsWrite() {
      return isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /userSettings/{settingsId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /weeklyGoals/{goalId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /dailyPlans/{planId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /sessions/{sessionId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /tasks/{taskId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /progressLogs/{logId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /dailyReports/{reportId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /weeklyReports/{reportId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /achievements/{achievementId} {
      allow read, write: if ownsResource() || ownsWrite();
    }

    match /xpHistory/{xpLogId} {
      allow read, write: if ownsResource() || ownsWrite();
    }
  }
}
